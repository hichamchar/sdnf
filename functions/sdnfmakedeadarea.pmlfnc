--
-- Description:
--   Makes area in DB for collecting deleted items.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfMakeDeadArea( ) is SDNFERROROBJ

  -- Save start position
  !start = ( ref )

  -- Initialise Error object
  !error = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Loads SDNF Configuration Objects
  WORL
  NEW SITE $!!sdnfDeadObjArea
  NEW ZONE
  -- Return to WORLD
  WORL

  -- Finished

  -- Return to start
  $!start
  return !error

endfunction

------------------------------------------------------------------------
