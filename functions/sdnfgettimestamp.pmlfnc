--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfgettimestamp( ) is STRING

   !dateTime = object DATETIME( )

   !dth      = !dateTime.hour( ).string( )
   if( !dth.length( ).eq( 1 ) )then
      -- 0-9
      !dth = |0| + !dth
   endif

   !dtmin    = !dateTime.minute( ).string( )
   if( !dtmin.length( ).eq( 1 ) )then
      -- 0-9
      !dtmin = |0| + !dtmin
   endif

   !dts      = !dateTime.second( ).string( )
   if( !dts.length( ).eq( 1 ) )then
      -- 0-9
      !dts = |0| + !dts
   endif

   !dtd      = !dateTime.date( ).string( )
   if( !dtd.length( ).eq( 1 ) )then
      -- 0-9
      !dth = |0| + !dtd
   endif

   !dtmth    = !dateTime.month( ).string( )
   if( !dtmth.length( ).eq( 1 ) )then
      -- 0-9
      !dtmth = |0| + !dtmth
   endif

   !dty      = !dateTime.year( ).string( )
   if( !dty.length( ).eq( 1 ) )then
      -- 0-9
      !dty = |000| + !dty
   endif

   !timeStamp = !dty + !dtmth + !dtd + !dth + !dtmin + !dts
   -- Finished
   return !timeStamp

endfunction

------------------------------------------------------------------------
