--
-- Description:
--   Reverses a GENSEC Spine.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfReverseSpine( )

   -- Save start position
   !start = ( ref )

   if( !!ce.type.eq( |GENSEC| ) )then
      !lmirror = !!ce.attribute( |LMIRROR| )

      -- Flip values
      !lmirror = not !lmirror
      LMIRROR $!lmirror


      -- Reset SPINE YDIR
      SPINE 1
      last mem
      !oriVec = !!sdnfgetorivec( )
      end

      -- Parse OriVec into coordinates and set YDIR
      !coords = !oriVec.split( )
      !yVec = object DIRECTION( )
      !yVec.origin      = !!sdnfConfigObj.dbref()
      !yVec.east        = !coords[ 2 ].real( )
      !yVec.north       = !coords[ 4 ].real( )
      !yVec.up          = !coords[ 6 ].real( )
      YDIR $!yVec
      end

      BANG 0

      -- reverse points
      SPINE 1
      !points = mem
      !last = !points.size( ) - 1
      do !i from 1 to !last
         reorder last mem before $!i
      enddo
   endif

   -- Return to start
   $!start

endfunction

------------------------------------------------------------------------
