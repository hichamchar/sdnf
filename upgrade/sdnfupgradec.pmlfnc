-- File:            sdnfupgradec.pmlfnc
--   Type:          Function Definition
--   Group:         Integration Services
--   Keyword:       SDNF
--   Module:        paragon
--   Replaces:
--
-- Author:          D.Wilson,,,
-- Created:         Fri Mar 06 14:07:39 1998
--
--
-- Description:
--   Upgrades the Standard Steel Catalogue Pline sets to include
--   additional Plines for SDNF export/import.  Specific for C shapes.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type] [Description]
--    REAL       Error Code
------------------------------------------------------------------------
--
-- Significant Catalogue Parameters:
--  [#] [Description]                  [Specials]
--
-- Old Catalogue
--   1  Depth
--   2  Width
--   3  Web thickness
--   4  Flange thickness
--   5  Cy (X offset)
--
-- New Catalogue
--  ATTRIB RPRO DPTH - Depth
--  ATTRIB RPRO WIDA - Width A
--  ATTRIB RPRO WTHK - Web Thickness
--  ATTRIB RPRO FTKA - Flange Thickness A
--  ATTRIB RPRO CGYO - CofG Y Axis Offset

------------------------------------------------------------------------

-- Define function
define function !!sdnfUpgradeC( !newCatalogue is BOOLEAN ) is REAL

    -- Initialisation
    !error  = !!sdnfCPErrOK
    !origin = ( ref )

    -- Build map of existing PLINes
    !plineMap = ARRAY()

    -- Collect all old SNF Plines
    !!ce = !origin
    var !coll collect all PLIN with (substring((PKEY ),1,3) eq |SNF|)for CE

    if( not !coll.empty( ) )then
        -- Build a map indexed on PKEY that it will be set to - can't delete them
        do !i values !coll
            $!i
            !oldPkey = PKEY
            !keyIndex = !!sdnfCPPkeys[ 1 ].findFirst( !oldPkey )
            if( !keyIndex.set() )then
                !newPkey = !!sdnfCPPkeys[ 2 ][ $!keyIndex ]
                var !pkeyString hash( '$!newPkey' )
                !index = !pkeyString.real( )
                !plineMap[ !index ] = !i.dbref( )
            else
            -- It really shouldn't be unset
            endif
        enddo
    endif

    -- Collect new Plines from new catalogue
    !!ce = !origin
    !plineFilter = 'PKEY inset (|LBOT|,|CBOT|,|RBOT|,|LMID|,|CMID|,|RMID|,|LTOP|,|CTOP|,|RTOP|,|BNA|,|LNA|,|RNA|,|TNA|,|NA|)'
    var !coll collect all PLIN with ($!plineFilter)for CE

    if( not !coll.empty( ) )then
        -- Build a map indexed on PKEY - can't delete them
        do !i values !coll
            $!i
            !pkey = PKEY
            var !pkeyString hash( '$!pkey' )
            !index = !pkeyString.real( )
            -- Test if clash with Plines
            !testIndex = !plineMap[ !index ]
            handle any
            elsehandle NONE
                !errMes = |Pline clash: | + !i.dbref( ).string() + |(| + !i.dbref( ).PKEY + |) and | + !testIndex.string() + |(| + !testIndex.pkey + |)|
                write !errMes
            endhandle
            -- Overwrite with later (non SDNF) one
            !plineMap[ !index ] = !i.dbref( )
        enddo
    endif


  -- Create all new PLINes necessary keyed under their new names
  !pkeysHashed = ARRAY( )
  do !i to !!sdnfCPPkeys[ 2 ].size( )
      !pkey = !!sdnfCPPkeys[ 2 ][ $!i ]
      var !pkeyString hash( |$!pkey| )
      !index = !pkeyString.real( )
      !pkeysHashed[ $!i ] = !index
      -- Try going to PLINe called SNF[A-N]
      $!plineMap[ $!index ]
      handle( 2,109 )( 2,752 )
        -- Failed - create it
        NEW PLIN $!!sdnfCPData
        PKEY $!pkey
        !ref = ( ref )
        !plineMap[ !index ] = !ref
      endhandle
  enddo


  -- Set Pline dimensions
if( !newCatalogue )then
  -- New Catalogue
  -- Note: Default orientation is the other way (and mirrored)
  !yNAOff = |0.0|
  !yOff  = |( -1.0 * ATTRIB RPRO DPTH / 2.0 )|
  !yMid   = |0.0|
  !nYOff   = |( ATTRIB RPRO DPTH / 2.0 )|
  !xNAOff = |0.0|
  !nXOff   = |( - 1.0 * ATTRIB RPRO CGYO )|
  !xMid   = |( ( ATTRIB RPRO WIDA / 2.0 ) - ATTRIB RPRO CGYO )|
  !xOff  = |( ATTRIB RPRO WIDA - ATTRIB RPRO CGYO )|
  !lDir   = |-X|
  !rDir   = |X|
  !uDir   = |-Y|
  !dDir   = |Y|
else
  -- Old Catalogue
  !yNAOff = |0.0|
  !nYOff  = |( ATTRIB CPARA[ 1 ] / 2.0 )|
  !yMid   = |0.0|
  !yOff   = |( -1.0 * ATTRIB CPARA[ 1 ] / 2.0 )|
  !xNAOff = |0.0|
  !nXOff  = |( -1.0 * ATTRIB CPARA[ 5 ] )|
  !xMid   = |( ( ATTRIB CPARA[ 2 ] / 2.0 ) - ATTRIB CPARA[ 5 ] )|
  !xOff   = |( ATTRIB CPARA[ 2 ] - ATTRIB CPARA[ 5 ] )|
  !lDir   = |-X|
  !rDir   = |X|
  !uDir   = |-Y|
  !dDir   = |Y|
endif


  -- All requisite PLINes exist now


  -- Cardinal point 1
  $!plineMap[ $!pkeysHashed[ 1 ] ]
  PKEY LTOP
  PX $!nXOff PY $!nYOff PLAX $!dDir

  -- Cardinal point 2
  $!plineMap[ $!pkeysHashed[ 2 ] ]
  PKEY CTOP
  PX $!xMid PY $!nYOff PLAX $!dDir

  -- Cardinal point 3
  $!plineMap[ $!pkeysHashed[ 3 ] ]
  PKEY RTOP
  PX $!xOff PY $!nYOff PLAX $!dDir

  -- Cardinal point 4
  $!plineMap[ $!pkeysHashed[ 4 ] ]
  PKEY LMID
  PX $!nXOff PY $!yMid PLAX $!lDir

  -- Cardinal point 5
  $!plineMap[ $!pkeysHashed[ 5 ] ]
  PKEY CMID
  PX $!xMid  PY $!yMid PLAX $!uDir

  -- Cardinal point 6
  $!plineMap[ $!pkeysHashed[ 6 ] ]
  PKEY RMID
  PX $!xOff PY $!yMid PLAX $!rDir

  -- Cardinal point 7
  $!plineMap[ $!pkeysHashed[ 7 ] ]
  PKEY LBOT
  PX $!nXOff PY $!yOff PLAX $!dDir

  -- Cardinal point 8
  $!plineMap[ $!pkeysHashed[ 8 ] ]
  PKEY CBOT
  PX $!xMid PY $!yOff PLAX $!uDir

  -- Cardinal point 9
  $!plineMap[ $!pkeysHashed[ 9 ] ]
  PKEY RBOT
  PX $!xOff PY $!yOff PLAX $!uDir

  -- Cardinal point 10
  $!plineMap[ $!pkeysHashed[ 10 ] ]
  PKEY NA
  PX $!xNAOff PY $!yNAOff

  -- Cardinal point 11
  $!plineMap[ $!pkeysHashed[ 11 ] ]
  PKEY TNA
  PX $!xNAOff PY $!nYOff PLAX $!dDir

  -- Cardinal point 12
  $!plineMap[ $!pkeysHashed[ 12 ] ]
  PKEY LNA
  PX $!nXOff PY $!yNAOff PLAX $!lDir

  -- Cardinal point 13
  $!plineMap[ $!pkeysHashed[ 13 ] ]
  PKEY RNA
  PX $!xOff PY $!yNAOff PLAX $!rDir

  -- Cardinal point 14
  $!plineMap[ $!pkeysHashed[ 14 ] ]
  PKEY BNA
  PX $!xNAOff PY $!yOff PLAX $!uDir

  -- Finished - return to base
  $!origin
  return !error

endfunction
