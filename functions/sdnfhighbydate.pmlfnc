--
--
-- Description:
--   Highlights items according to date criteria.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Search starting point
--    2   R      REAL        Start Day
--    3   R      STRING      Start Month
--    4   R      REAL        Start Year
--    5   R      REAL        End Day
--    6   R      STRING      End Month
--    7   R      REAL        End Year
--    8   R      STRING      ALL or ALLBUT
--    9   R      STRING      Status - concatenated string of CHANGED, ADDED, DELETED
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfHighByDate( !ref is DBREF, !startDay is REAL, $
      !startMonth is STRING, !startYear is REAL,  !endDay is REAL, $
      !endMonth is STRING, !endYear is REAL, !allOrAllBut is STRING, $
      !statusMask is STRING ) is SDNFERROROBJ

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Set initial status
  !origin = ( ref )
  !startDate = object DATETIME( !startYear, !startMonth, !startDay)
  !endDate   = object DATETIME( !endYear, !endMonth, !endDay)
  if( !endDate lt !startDate )then
    -- End before start
    !error.severity = !!sdnfSevWarn
    !error.status   = !!sdnfErrBadDate
    !error.query    = !!sdnfQueNone
    !reply = !!sdnfError( !error )
    golabel /Finished
  endif

  -- Get list of items
  var !refList collect all ( SCTN GENSEC PANE ) for $!ref

  --Work out initial filter
  !filter = |neq|
  if( !allOrAllBut eq |ALLBUT| )then
    !filter = |eq|
  endif
  -- Apply initial filter on CHANGED|DELETED|ADDED status
  !newRefList = ARRAY( )
  do !item values !refList
    !status = ( :SDNFSTATUS of $!item )
    if( !statusMask.match( !status ) $!filter 0 )then
      -- This is one we want
      !newRefList.append( !item )
    endif
  enddo

  -- Now go down this list for date comparison
  !highlightList = ARRAY( )
  if( !newRefList.size( ) eq 0 )then
    -- Nothing to process
    !error.severity = !!sdnfSevWarn
    !error.status   = !!sdnfErrNoHighLig
    !error.query    = !!sdnfQueNone
    !reply = !!sdnfError( !error )
    golabel /Finished
  else
    do !item values !newRefList
      !iDate = ( :SDNFIDATE of $!item )
      if( !iDate.length( ) gt 0 )then
        -- Has been imported
        !day   = !iDate.part( 1 ).real( )
        !month = !iDate.part( 2 )
        !year  = !iDate.part( 3 ).real( )
        !testDate = object DATETIME( !year, !month, !day )
        if( !testDate ge !startDate and $
            !testDate le !endDate )then
          -- Satisfies highlight requirements
          !highlightList.append( !item )
        endif
      else
        -- Ignore non imported ones
      endif
    enddo
  endif

  if( not !!sdnftty ) then
    unenhance all
  endif
  if( !highlightList.size( ) eq 0 )then
    -- Nothing to process
    !error.severity = !!sdnfSevWarn
    !error.status   = !!sdnfErrNoHighLig
    !error.query    = !!sdnfQueNone
    !reply = !!sdnfError( !error )
    golabel /Finished
  else
    if( not !!sdnftty ) then
      -- Go and highlight them
      do !item values !highlightList
        -- Choose colour
        !status = ( :SDNFSTATUS of $!item )
        if( !status eq |ADDED| )then
          !colour = !!sdnfColAdded
        elseif( !status eq |CHANGED| )then
          !colour = !!sdnfColChanged
        elseif( !status eq |DELETED| )then
          !colour = !!sdnfColDeleted
        endif
        enhance $!item col $!colour
      enddo
    endif
  endif

  -- Finished
  label /Finished
  $!origin
  return !error

endfunction

------------------------------------------------------------------------
