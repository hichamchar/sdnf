-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]  [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfExpInfoInit( )

  -- Initialise choices
  !!sdnfExpInfo.expFile.val      = !!sdnfExpdata.file
  !!sdnfExpInfo.expFileMode.val  = !!sdnfExpdata.fileMode

  !!sdnfExpInfo.expHdrText.val   = |Packet 00 from: | + !!sdnfExpdata.hdrSource
  !!sdnfExpInfo.expLinMem.val    = !!sdnfExpdata.linMem
  !!sdnfExpInfo.expArcMem.val    = !!sdnfExpdata.arcMem
  !!sdnfExpInfo.expPlate.val     = !!sdnfExpdata.plate
  !!sdnfExpInfo.expHoles.val     = !!sdnfExpdata.holes
  if( !!sdnfExpdata.endConn )then
    !!sdnfExpInfo.expLinMemDet.select( |FULL| )
  else
    !!sdnfExpInfo.expLinMemDet.select( |BRIEF| )
  endif
  call !!sdnfSetLinMemOpt( !!sdnfExpInfo.expLinMem.val )
  call !!sdnfSetExpPltOpt( !!sdnfExpInfo.expPlate.val )

  !!sdnfExpInfo.fileVersion      = !!sdnfExpdata.fileVersion

  -- Set Member data
  !!sdnfExpInfo.file       = !!sdnfExpdata.file
  !!sdnfExpInfo.fileMode   = !!sdnfExpdata.fileMode
  !!sdnfExpInfo.linMem     = !!sdnfExpdata.linMem
  !!sdnfExpInfo.arcMem     = !!sdnfExpdata.arcMem
  !!sdnfExpInfo.plate      = !!sdnfExpdata.plate
  !!sdnfExpInfo.holes      = !!sdnfExpdata.holes
  !!sdnfExpInfo.endConn    = !!sdnfExpdata.endConn
  !!sdnfExpInfo.specMode   = !!sdnfExpdata.specMode
  !!sdnfExpInfo.markMode   = !!sdnfExpdata.markMode
  !!sdnfExpInfo.hdrSource  = !!sdnfExpdata.hdrSource
  !!sdnfExpInfo.modelType  = !!sdnfExpdata.modelType
  !!sdnfExpInfo.modelNr    = !!sdnfExpdata.modelNr

endfunction

