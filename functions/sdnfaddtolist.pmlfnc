--
--
-- Description:
--   Adds entity to list for Export.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      ADD option = [CE|STRUC|PICK|]
--
-- Return:
--   [Data Type] [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfAddToList( !option is STRING ) is ARRAY

  -- Save start point
  !origin   = ( ref )
  trace off

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Save list gadget first
  !tempList = !!sdnfExpdata.expList
  !elementList = ARRAY( )
  do !e values !tempList
    if( !e.split( ).size( ).eq( 1 ) )then
      !elementList.append( |/| + !e )
    else
      !elementList.append( !e )
    endif
  enddo
  !nameList    = ARRAY( )

  -- Add selection
  !correctElement = true
  if( !option eq |CE| )then
    !ref = ( ref )
    !type = ( type )
    if( !type eq |WORL| )then
      -- Cannot Export WORLD
      !error.severity = !!sdnfSevWarn
      !error.status   = !!sdnfErrNoExpWorl
      !reply = !!sdnfError( !error )
      !correctElement = false
    else
      !elementList.append( !ref.string( ) )
      if( not !!sdnftty ) then
        do !i values !elementList
  --     rem $!i add $!i colour $!!sdnfColExported
          $!i
          enhance all SCTN for ce colour $!!sdnfColExported
          enhance all PANE for ce colour $!!sdnfColExported
          enhance all GENSEC for ce colour $!!sdnfColExported
        enddo
      endif
    endif
  elseif( !option eq |STRUC| )then
    STRUC
    handle( 2,111 )
       -- Cannot/no need to climb to a structure
      !error.severity = !!sdnfSevWarn
      !error.status   = !!sdnfErrNoOwnStru
      !reply = !!sdnfError( !error )
      !correctElement = false
    endhandle
    if( !correctElement )then
      !ref = ( ref )
      !elementList.append( !ref.string( ) )
      if( not !!sdnftty ) then
        do !i values !elementList
  --      rem $!i add $!i colour $!!sdnfColExported
          $!i
          handle( 2,113 )
             -- Item does not exist - probably deleted
             skip
          endhandle
          enhance all SCTN for ce colour $!!sdnfColExported
          enhance all PANE for ce colour $!!sdnfColExported
          enhance all GENSEC for ce colour $!!sdnfColExported
        enddo
      endif
    endif
  elseif( !option eq |PICK| )then
    if( not !!sdnftty ) then
      do
        var !item pick
        handle( 61,528 )
          -- User cancelled
          break
        endhandle
        $!item[ 1 ]
        !ref = ( ref )
        !elementList.append( !ref.string( ) )
--      rem $!ref add $!ref colour $!!sdnfColExported
        enhance all SCTN for ce colour $!!sdnfColExported
        enhance all PANE for ce colour $!!sdnfColExported
        enhance all GENSEC for ce colour $!!sdnfColExported
        -- Loop round
      enddo
    endif
  endif

  if( !correctElement )then
    -- Remove duplicates
    !elementList.sort( )
    !elementList.unique( )

    -- Write back list gadget
    do !item values !elementList
      !name = ( name of $!item )
      if( !name.match( |=| ).eq( 1 ) )then
        !name = ( flnn of $!item )
      elseif( !name.match( |/| ).eq( 1 ) )then
        !name = !name.after( |/| )
      endif
      !nameList.append( !name )
    enddo
    !nameList.sort( )
    !nameList.unique( )

    !!sdnfExpdata.expList      = !nameList
  endif

  -- Return to base
  $!origin
  trace on
  return !nameList

endfunction

------------------------------------------------------------------------
