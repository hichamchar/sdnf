--
-- Description:
--    Checks Cardinal Point equivalence
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfcheckcpequiv( !cPoint1 is STRING, !cPoint2 is STRING ) is BOOLEAN

   -- Pline Equivalences
   do !equivalence values !!sdnfCPBMEQUIV
      if( !equivalence.match( !cPoint1 ).gt( 0 ) and !equivalence.match( !cPoint2 ).gt( 0 ) )then
         return true
      endif
   enddo

   -- Not found
   return false

endfunction
