-- Define function
define function !!sdnfRemCPData( )

  -- Cardinal point Pkeys
  var !!sdnfCPPkeys     delete
  -- Max Cardinal point index
  var !!sdnfCPMaxIndex  delete
  -- Plate Cardinal points
  var !!sdnfCPlPkeys    delete
   -- Max Cardinal point index
  var !!sdnfCPlMaxIndex delete

  -- Array of Plines used to test if system has been installed
  var !!sdnfTestPlines delete

  -- Basic Mapping
  var !!sdnfCPBMEQUIV delete

  var !!sdnfSNFENAEq delete
endfunction
