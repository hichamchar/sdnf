-- Define function
define function !!sdnfSetExpFilVsn( )

  -- Set Form member data
  !!sdnfExpInfo.fileVersion = !!sdnfExpInfo.vVersion.selection( )
  !!sdnfsetexppltopt( !!sdnfExpInfo.expPlate.val )

endfunction

