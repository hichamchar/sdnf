--
--
-- Description:
--   Sets Mapping File according to arguments.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Direction [EXPORT|IMPORT]
--    2   R      STRING      Mode [MANUAL|AUTO]
--    3   R      STRING      Map Type [PROFILE|MATERIAL]
--    4   R      STRING      Mapping file name
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ  Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetMap( !direction is STRING, !mode is STRING, $
  !mapType is STRING, !inFile is STRING ) is SDNFERROROBJ

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Strip out environment variables
  if( !inFile.unset( ) or !inFile.length( ) eq 0 )then
    !inFile = | |
  endif
  !file = !!sdnfExpandEnv( !inFile )

  -- Go and do the right thing
  if( !direction eq |EXPORT| )then
    if( !mode eq |AUTO| )then
      !error = !!sdnfSetAutoTMap( !file )
      !error = !!sdnfSetAutoTMat( !file )
      !error = !!sdnfSetAutoTOri( !file )
      !error = !!sdnfSetAutoTUni( !file )
    elseif( !mode eq |MANUAL| )then
      if( !mapType eq |PROFILE| )then
        !error = !!sdnfSetUserTMap( !file )
      elseif( !mapType eq |MATERIAL| ) then
        !error = !!sdnfSetUserTMat( !file )
      elseif( !mapType eq |ORIENT| ) then
        !error = !!sdnfSetUserTOri( !file )
      elseif( !mapType eq |UNICODE| ) then
        !error = !!sdnfSetUserTUni( !file )
      else
        -- Bad map type
      endif
    else
      -- Unknown mode
    endif
  elseif( !direction eq |IMPORT| )then
    if( !mode eq |AUTO| )then
      !error = !!sdnfSetAutoSMap( !file )
      !error = !!sdnfSetAutoSMat( !file )
      !error = !!sdnfSetAutoSOri( !file )
      !error = !!sdnfSetAutoSUni( !file )
    elseif( !mode eq |MANUAL| )then
      if( !mapType eq |PROFILE| )then
        !error = !!sdnfSetUserSMap( !file )
      elseif( !mapType eq |MATERIAL| ) then
        !error = !!sdnfSetUserSMat( !file )
      elseif( !mapType eq |ORIENT| ) then
        !error = !!sdnfSetUserSOri( !file )
      elseif( !mapType eq |UNICODE| ) then
        !error = !!sdnfSetUserSUni( !file )
      else
        -- Bad map type
      endif
    else
      -- Unknown mode
    endif
  else
    -- Unknown direction
  endif

   -- Update Search Start
   if( !file.upcase( ).neq( |NULL| ) )then
      !testFile = object FILE( !file )
      if( !testFile.set( ) )then
         !pathName = !testFile.pathName()
         if( !pathName.length( ).gt( 0 ) )then
            !!sdnfSearchStart = !pathName
         endif
      endif
   endif

  -- Finished
  return !error

endfunction

------------------------------------------------------------------------
