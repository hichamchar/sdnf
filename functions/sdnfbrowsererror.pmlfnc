--
-- Description:
--   Manages error in File Browser form.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    NONE
--
-- Return:
--   [Data Type]   [Description]
--    NONE
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfBrowserError( )

  -- Reset !!CDSFILE variable
  call !!sdnfResetCDSFILE( )

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevError
  !error.status   = !!sdnfErrOnBrowser
  !error.query    = !!sdnfQueNone

  -- Manage Error
  !unusedReply = !!sdnfError( !error )

endfunction

------------------------------------------------------------------------
