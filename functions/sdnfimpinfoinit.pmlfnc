-- Define function
define function !!sdnfImpInfoInit( )

  -- Initialise choices
  !!sdnfImpInfo.impFile.val      = !!sdnfImpdata.file

  !!sdnfImpInfo.impLinMem.val    = !!sdnfImpdata.linMem
  !!sdnfImpInfo.impArcMem.val    = !!sdnfImpdata.arcMem
  !!sdnfImpInfo.impPlate.val     = !!sdnfImpdata.plate
  !!sdnfImpInfo.impHoles.val     = !!sdnfImpdata.hole

  !!sdnfImpInfo.fileVersion      = !!sdnfImpdata.fileVersion

  -- Set Member data
  !!sdnfImpInfo.file       = !!sdnfImpdata.file
  !!sdnfImpInfo.linMem     = !!sdnfImpdata.linMem
  !!sdnfImpInfo.arcMem     = !!sdnfImpdata.arcMem
  !!sdnfImpInfo.plate      = !!sdnfImpdata.plate
  !!sdnfImpInfo.hole       = !!sdnfImpdata.hole
  !!sdnfImpInfo.endConn    = !!sdnfImpdata.endConn
  !!sdnfImpInfo.specMode   = !!sdnfImpdata.specMode
  !!sdnfImpInfo.modelType  = !!sdnfImpdata.modelType

endfunction

