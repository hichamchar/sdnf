-- Define function
define function !!sdnfSetExpRunInf( )

  -- Set Form Member Data
  !!sdnfExpRunInf.viewMode = !!sdnfExpRunInf.expMode.selection( )
  !!sdnfExpRunInf.viewLog  = !!sdnfExpRunInf.expViewLog.val
  !!sdnfExpRunInf.testRun  = !!sdnfExpRunInf.expTestRun.val

  -- Set Export Form member data
  !!sdnfExpdata.viewMode    = !!sdnfExpRunInf.viewMode
  !!sdnfExpdata.viewLog     = !!sdnfExpRunInf.viewLog
  !!sdnfExpdata.testRun     = !!sdnfExpRunInf.testRun

endfunction

