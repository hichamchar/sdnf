--
-- Description:
--   Returns a list of deleted items if they have not been moved from the original areas
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfgetdelitems( ) is ARRAY

   -- Start
   !origin       = !!ce
   !deletedItems = ARRAY( )

   var !oldSites coll all SITE where ( match( name, !!sdnfPrefix + |OLD-|) gt 0 )
   do !oldSite values !oldSites
      $!oldSite
      var !temp coll all (SCTN GENSEC PANE) for $!oldSite
      !deletedItems.appendArray( !temp )
   enddo
   -- Finished
   !!ce = !origin

   return !deletedItems

endfunction

------------------------------------------------------------------------
