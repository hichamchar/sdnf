--
-- Description:
--   Sets main Import form Import Information.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]   [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetImpImpInf( )

  -- Set Form member data
  !!sdnfImpInfo.file       = !!sdnfImpInfo.impFile.val
  !!sdnfImpInfo.linMem     = !!sdnfImpInfo.impLinMem.val
  !!sdnfImpInfo.arcMem     = !!sdnfImpInfo.impArcMem.val
  !!sdnfImpInfo.plate      = !!sdnfImpInfo.impPlate.val
  !!sdnfImpInfo.hole       = !!sdnfImpInfo.impHoles.val

  if( not !!sdnfImpInfo.impHoles.active )then
    -- May be suppressed because of file version
    !!sdnfImpInfo.hole = false
  endif

  -- Set main Import Form member data
  !!sdnfImpdata.file        = !!sdnfImpInfo.file
  !!sdnfImpdata.linMem      = !!sdnfImpInfo.linMem
  !!sdnfImpdata.arcMem      = !!sdnfImpInfo.arcMem
  !!sdnfImpdata.plate       = !!sdnfImpInfo.plate
  !!sdnfImpdata.hole        = !!sdnfImpInfo.hole
  !!sdnfImpdata.specMode    = !!sdnfImpInfo.specMode

  !!sdnfImpdata.fileVersion = !!sdnfImpInfo.fileVersion

  !!sdnfImpdata.modelType   = !!sdnfImpInfo.modelType

  -- output warning if we are not importing anything
  if( not !!sdnfImpInfo.linMem and not !!sdnfImpInfo.arcMem and not !!sdnfImpInfo.plate )then
    -- Nothing to import
    !error          = object SDNFERROROBJ( )
    !error.severity = !!sdnfSevWarn
    !error.status   = !!sdnfErrNoImpItem
    !error.query    = !!sdnfQueNone
    !unusedReply = !!sdnfError( !error )
  endif


endfunction

