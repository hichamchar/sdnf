--
--
-- Description:
--   Sets Mapping File mode for Target Map in SDNF Target Info form.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]   [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetTMapMode( )

  -- Set Form member data
  !mapMode = !!sdnfTargInfo.targetMapMode.selection( )
  !!sdnfTargInfo.mapMode = !mapMode

  -- In/activate options
  if( !mapMode eq |MANUAL| )then
    -- Manual settings
    !!sdnfTargInfo.autoTargetMap.active = true
    !!sdnfTargInfo.userTargetFile.active = true
    !!sdnfTargInfo.tMapBrowse.active = true
    !!sdnfTargInfo.targetMatMode.active = true
  elseif( !mapMode eq |AUTO| )then
    -- Automatic settings
    !!sdnfTargInfo.autoTargetMap.active = true
    !!sdnfTargInfo.userTargetFile.active = false
    !!sdnfTargInfo.tMapBrowse.active = false
    !!sdnfTargInfo.targetMatMode.active = false

    -- Reset form to current setting
    call !!sdnfSetMap( |EXPORT|, |AUTO|, |PROFILE|, | | )

  endif

endfunction

------------------------------------------------------------------------
