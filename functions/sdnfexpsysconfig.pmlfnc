-- Define function
define function !!sdnfexpsysconfig( !form is FORM )

   show !!sdnfsysconfigfrm
   !!sdnfsysconfigfrm.showForm( |EXPORT|, !form )
   -- Can't initialise the Export form here as the Config form isn't a blocking one

endfunction

