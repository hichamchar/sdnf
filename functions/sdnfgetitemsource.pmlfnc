--
-- Description:
--   Detects origin of item - AVEVA or EXTERNAL.
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfgetitemsource( !ref is DBREF ) is STRING

   -- save starting point
   !start = !!ce
   !source = !!sdnfThisProg

   -- Use AVEVA database reference number or External Mark Nr.
   !!ce = !ref

   -- Use :SDNFEMARK as refno
   !test = ( :SDNFEMARK )
   if( !test.length( ) gt 0 )then
      -- Pre-pend '=' to make it look like a refno
      !expRef = |=| + !test
      -- Check if it is the AVEVA database reference number of this item
      $!expRef
      handle any
         -- It is not - leave it.  It is an external refno or rubbish.
         !source = |EXTERNAL|
      endhandle
   endif

   -- return to base
   !!ce = !start
   return !source

endfunction
