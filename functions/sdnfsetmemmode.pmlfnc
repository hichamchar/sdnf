-- Description:
--   Sets detail flags for exporting linear members.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]   [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetMemMode( )

  -- Set Form member data
  !mode = !!sdnfExpInfo.expLinMemDet.selection( )
  if( !mode eq |BRIEF| )then
    !!sdnfExpInfo.linMem  = true
    !!sdnfExpInfo.endConn = false
  elseif( !mode eq |FULL| )then
    !!sdnfExpInfo.linMem  = true
    !!sdnfExpInfo.endConn = true
  endif
endfunction

