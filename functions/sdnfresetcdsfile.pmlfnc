--
-- Description:
--   Resets !!CDSFILE variable to |null|, returning old value.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    NONE
--
-- Return:
--   [Data Type]   [Description]
--    STRING        Value of CDSFILE
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfResetCDSFILE( ) is STRING

  -- Save original value
  !temp = !!cDSFILE

  -- Reset !!CDSFILE
  !!cDSFILE = |null|

  -- Return old value
  return !temp

endfunction

