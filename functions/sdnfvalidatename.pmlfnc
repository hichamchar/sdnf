--
-- Description:
--   Ensures a name is within 50 characters
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   RW     STRING      name
--
-- Return:
--   [Data Type]   [Description]
--    STRING        name
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfValidateName( !name is STRING ) is STRING

  !newName = !name
  if( !name.length( ) gt 50 )then
    -- contract it to 50 characters, separated by ... in the middle
    !unusedLength = !name.length( )
    !newName = !!sdnfContractString( !name, 50, |...| )
  endif

  return !newName

endfunction

------------------------------------------------------------------------
