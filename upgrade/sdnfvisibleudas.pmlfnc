--
--
-- Description:
--   Show or hide UDAs

-- Define function
define function !!sdnfvisibleudas( !prefix is STRING, !globalVisibility is BOOLEAN, !localList is STRING )

   -- save start position
   !start = !!ce

   -- Set UDA WORLD name here
   if( !prefix.upcase().match( |SDNF| ).gt( 0 ) or $
       !prefix.upcase().match( |FAB| ).gt( 0 ) )then

      -- Construct UWRL name
      !uwrl = |/| + !prefix.upcase() + |-UWRL|
      $!uwrl
      handle ANY
         -- Probably UWRL does not exist
         return
      endhandle
      !visible = not !globalVisibility
      !udas = !!ce.members

      !hasLocals = false
      !locals = ARRAY( )
      if( !localList.length().gt( 0 ) )then
         !hasLocals = true
         !locals = !localList.split( )
      endif

      -- turn them all on/off
      do !uda values !udas
         !!ce = !uda
         var !udna udname
         UHIDE $!visible

         -- is this one of the ones we want to be visible whatever?
         do !local values !locals
            if( !local.upcase( ).eq( !udna ) )then
               UHIDE false
               break
            endif
         enddo
      enddo

      -- Done
      compile
   endif

   -- restore start position
   !!ce = !start

endfunction
