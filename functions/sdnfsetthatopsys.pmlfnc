--
-- Description:
--   Sets the Operating System for the other package.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      UNIX or WINDOWS
--
-- Return:
--   [Data Type]   [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetThatOpSys( !opSystem is STRING )

  -- Set Global variables
  !!sdnfOtherOpSys = !opSystem

  -- Load in Operating system specific stuff according to OpSystem chosen
  call !!sdnfLoadOSData( )

  -- Set option gadgets on both Import and Export Run Information forms
  !!sdnfImpRunInf.thatOpSystem.select( |DTEXT|, !!sdnfOtherOpSys )
  handle( 2,751 )
    -- Probably form does not exist
    golabel /DoExpForm
  endhandle
  !!sdnfImpRunInf.otherOpSys = !opSystem

  label /DoExpForm
  !!sdnfExpRunInf.thatOpSystem.select( |DTEXT|, !!sdnfOtherOpSys )
  handle( 2,751 )
    -- Probably form does not exist
    golabel /Finished
  endhandle
  !!sdnfExpRunInf.otherOpSys = !opSystem

  label /Finished

endfunction

------------------------------------------------------------------------
