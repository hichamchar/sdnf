-- Define function
define function !!sdnfimpsysconfig( !form is FORM )

   show !!sdnfsysconfigfrm
   !!sdnfsysconfigfrm.showForm( |IMPORT|, !form )
   -- Can't initialise the Import form here as the Config form isn't a blocking one

endfunction

