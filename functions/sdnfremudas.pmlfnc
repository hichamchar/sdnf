--
-- Description:
--   Removes SDNF UDAs from the Dictionary database.
--   Macro to be called from Lexicon.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type] [Description]
--    None
------------------------------------------------------------------------

-- Define function
define function !!sdnfRemUDAs( )

  -- Removes all SDNF related UDAs in the Lexicon DB
  WORL

  -- Collect all UDAs with SDNF in their PKEY
  var !list coll all UDA where ( matchwild( UDNA, |SDNF*| ) ) for CE
  !length = !list.size( )
  write( |$!length $!!sdnfShortProduct UDAs to delete| )

  -- Go and delete them
  do !val values !list
    $!val
    write( |Deleting UDA $!val| )
    DELETE UDA
    handle any
      write( |Error in deleting UDA $!val| )
    endhandle
  enddo

  -- save it all
  compile


endfunction

------------------------------------------------------------------------
