-- Define function
define function !!sdnfgetequivalent( !progName is STRING ) is STRING

   -- look for equivalents
   !found = false
   !module = !progName

   do !equivalent values !!sdnfExtProgEquList
      if( !progName.upcase( ).eq( !equivalent[ 1 ].upcase( ) ) )then
         !found = true
         !module = !equivalent[ 2 ]
      endif
   enddo

   return !module

endfunction

