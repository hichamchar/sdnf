-- Define function
define function !!sdnfImpRunInfIni( )

  -- Initialise choices
  !!sdnfImpRunInf.impViewLog.val    = !!sdnfImpdata.viewLog
  !!sdnfImpRunInf.impMode.val       = !!sdnfImpdata.viewMode
  !!sdnfImpRunInf.impSaveModel.val  = !!sdnfImpdata.saveModel
  !!sdnfImpRunInf.impSortMode.val   = !!sdnfImpdata.sortMode
  !!sdnfImpRunInf.impSortMode.val   = !!sdnfImpdata.sortMode
  !!sdnfImpRunInf.impMapVerify.val  = !!sdnfImpdata.mapVerify
  !!sdnfImpRunInf.impMarkVerify.select( |DTEXT|, !!sdnfImpdata.markVerify )

  -- Set Member Data
  !!sdnfImpRunInf.viewMode       = !!sdnfImpdata.viewMode
  !!sdnfImpRunInf.viewLog        = !!sdnfImpdata.viewLog
  !!sdnfImpRunInf.saveModel      = !!sdnfImpdata.saveModel
  !!sdnfImpRunInf.sortMode       = !!sdnfImpdata.sortMode
  !!sdnfImpRunInf.mapVerify      = !!sdnfImpdata.mapVerify
  !!sdnfImpRunInf.markVerify     = !!sdnfImpdata.markVerify

  -- Attribute Comparison lists
  !!sdnfImpRunInf.linMemAttr   = !!sdnfImpdata.linMemAttr
  !!sdnfImpRunInf.plateAttr    = !!sdnfImpdata.plateAttr

endfunction

