-- Define function
define function !!sdnfSetProgress( !initString is STRING, !incString is STRING )

   !!sdnfProgCount = 0
   !initString = ||
   !incString  = ||

   if(not !!sdnftty)then
      --the !!fmsys.setProgress routine forces an update of the status bar
      !initString = |!!fmsys.setProgress(0)|
--      !incString  = |!!fmsys.setProgress(!perCentInt)|
      !incString  = |!!fmsys.setProgress(0)|
   endif

   -- try to initialise
   $!initString
   handle( 2,779 )
      -- old syntax
      !initString = ||
      !incString  = ||
   endhandle

endfunction
