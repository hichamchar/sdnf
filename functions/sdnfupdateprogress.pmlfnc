-- Define function
define function !!sdnfUpdateProgress( !count is REAL, !totalCount is REAL, !incProgress is STRING, !message is STRING )

   if(!!sdnftty)then
      return
   endif

   -- Do it every 5%
   !perCent = !count * ( 20 / !totalCount )
   handle any
      -- assume all done
      !perCent = 20.0
   endhandle

   !perCentInt = !perCent.int( ) * 5
   if( !perCentInt.neq ( !!sdnfProgCount ) )then
       !!sdnfProgCount = !perCentInt
       !promptMessage = !message + | - $!perCentInt% complete.|
       !!sdnfPrompt( |$!promptMessage| )
       -- Poke the UI to do a refresh
       $!incProgress
   endif

endfunction
