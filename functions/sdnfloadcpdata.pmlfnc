-- Define function
define function !!sdnfLoadCPData( )

  -- Cardinal point Pkeys
  !!sdnfCPPkeys.delete( )
  handle( 2,751 )
    -- Variable does not exist
  endhandle
  !!sdnfCPPkeys = ARRAY( )
  !!sdnfCPPkeys[ 1 ]  = ARRAY( )
  !!sdnfCPPkeys[ 1 ][ 1 ]  = |SNFA|
  !!sdnfCPPkeys[ 1 ][ 2 ]  = |SNFB|
  !!sdnfCPPkeys[ 1 ][ 3 ]  = |SNFC|
  !!sdnfCPPkeys[ 1 ][ 4 ]  = |SNFD|
  !!sdnfCPPkeys[ 1 ][ 5 ]  = |SNFE|
  !!sdnfCPPkeys[ 1 ][ 6 ]  = |SNFF|
  !!sdnfCPPkeys[ 1 ][ 7 ]  = |SNFG|
  !!sdnfCPPkeys[ 1 ][ 8 ]  = |SNFH|
  !!sdnfCPPkeys[ 1 ][ 9 ]  = |SNFI|
  !!sdnfCPPkeys[ 1 ][ 10 ] = |SNFJ|
  !!sdnfCPPkeys[ 1 ][ 11 ] = |SNFK|
  !!sdnfCPPkeys[ 1 ][ 12 ] = |SNFL|
  !!sdnfCPPkeys[ 1 ][ 13 ] = |SNFM|
  !!sdnfCPPkeys[ 1 ][ 14 ] = |SNFN|
  !!sdnfCPPkeys[ 2 ]  = ARRAY( )
  !!sdnfCPPkeys[ 2 ][ 1 ]  = |RBOT|
  !!sdnfCPPkeys[ 2 ][ 2 ]  = |CBOT|
  !!sdnfCPPkeys[ 2 ][ 3 ]  = |LBOT|
  !!sdnfCPPkeys[ 2 ][ 4 ]  = |RMID|
  !!sdnfCPPkeys[ 2 ][ 5 ]  = |CMID|
  !!sdnfCPPkeys[ 2 ][ 6 ]  = |LMID|
  !!sdnfCPPkeys[ 2 ][ 7 ]  = |RTOP|
  !!sdnfCPPkeys[ 2 ][ 8 ]  = |CTOP|
  !!sdnfCPPkeys[ 2 ][ 9 ]  = |LTOP|
  !!sdnfCPPkeys[ 2 ][ 10 ] = |NA|
  !!sdnfCPPkeys[ 2 ][ 11 ] = |BNA|
  !!sdnfCPPkeys[ 2 ][ 12 ] = |RNA|
  !!sdnfCPPkeys[ 2 ][ 13 ] = |LNA|
  !!sdnfCPPkeys[ 2 ][ 14 ] = |TNA|

  -- Max Cardinal point index
  !!sdnfCPMaxIndex = !!sdnfCPPkeys[ 1 ].size( )

  -- Array of Plines used to test if system has been installed
  !!sdnfTestPlines = ARRAY()
  !!sdnfTestPlines[ 1 ] = |SNFN|
  !!sdnfTestPlines[ 2 ] = |CMID|


  -- Plate Cardinal points
  !!sdnfCPlPkeys.delete( )
  handle( 2,751 )
    -- Variable does not exist
  endhandle
  !!sdnfCPlPkeys = ARRAY( )
  !!sdnfCPlPkeys[ 1 ] = |TOP DTOP UTOP|
  !!sdnfCPlPkeys[ 2 ] = |CENT DCEN UCEN|
  !!sdnfCPlPkeys[ 3 ] = |BOTT DBOT UBOT|

  -- Max Cardinal point index
  !!sdnfCPlMaxIndex = !!sdnfCPlPkeys.size( )

   -- Pline Equivalences
   !!sdnfCPBMEQUIV = ARRAY( )
   !!sdnfCPBMEQUIV.append( |TOAX TOAY| )

   -- Pline Equivalences for symmetric sections
   -- Here we have to map SNFE (CP5) against NA (CP10) for certain shape codes
   -- Bocad cannot deal with CP10
   !!sdnfSNFENAEq = ARRAY( )
   -- I
   -- plate girder
   -- parallel flange I
   -- Design Parameter Parallel
   -- Design Parameter Plate Girder
   !!sdnfSNFENAEq.append( |1| )
   -- FB
   -- flat bar
   -- Design Parameter Flat Bar
   !!sdnfSNFENAEq.append( |5| )
   -- CHS
   -- reinforcing bar (solid)
   -- Design Parameter Round Bar
   !!sdnfSNFENAEq.append( |6| )
   -- FB
   -- circular tube
   -- Design Parameter Circular Tube
   !!sdnfSNFENAEq.append( |7| )
   -- SHS/RHS
   -- rectangular tube
   -- box girder
   -- Design Parameter Rectangular or Square Tube
   -- Design Parameter Box Girder
   !!sdnfSNFENAEq.append( |8| )
   -- tapered flange I
   !!sdnfSNFENAEq.append( |10| )
   -- hexagonal bar
   -- Design Parameter Hex Bar
   !!sdnfSNFENAEq.append( |12| )
   -- Cone
   -- Design Parameter Cone
   !!sdnfSNFENAEq.append( |13| )

endfunction
