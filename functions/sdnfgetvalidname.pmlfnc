--
-- Description:
--   Finds a valid new name based on the input name.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]  [Description]
--    newName     STRING
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfGetValidName( !inputName is STRING ) is STRING


  !outputName                = !inputName
  do !count
    -- try going to location
    !outputName   = !!sdnfValidateName( !outputName )
    $!outputName
    handle( 2, 109 )
      -- location not found
      break
    endhandle
    -- ratchet up count
    !outputName = !inputName + |-$!count|
  enddo

  return !outputName

endfunction

------------------------------------------------------------------------
