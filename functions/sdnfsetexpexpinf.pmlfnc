--
-- Description:
--   Sets main Export form Export Information.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]   [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetExpExpInf( )

  -- Set Form member data
  !!sdnfExpInfo.file       = !!sdnfExpInfo.expFile.val
  !!sdnfExpInfo.fileMode   = !!sdnfExpInfo.expFileMode.val
  !!sdnfExpInfo.linMem     = !!sdnfExpInfo.expLinMem.val
  !!sdnfExpInfo.plate      = !!sdnfExpInfo.expPlate.val
  !!sdnfExpInfo.holes      = !!sdnfExpInfo.expHoles.val

  if( not !!sdnfExpInfo.expHoles.active )then
    -- May be suppressed because of file version
    !!sdnfExpInfo.holes = false
  endif

  -- Set main Export Form member data
  !!sdnfExpdata.file        = !!sdnfExpInfo.file
  !!sdnfExpdata.fileMode    = !!sdnfExpInfo.fileMode
  !!sdnfExpdata.linMem      = !!sdnfExpInfo.linMem
  !!sdnfExpdata.arcMem      = !!sdnfExpInfo.arcMem
  !!sdnfExpdata.plate       = !!sdnfExpInfo.plate
  !!sdnfExpdata.holes       = !!sdnfExpInfo.holes
  !!sdnfExpdata.endConn     = !!sdnfExpInfo.endConn
  !!sdnfExpdata.specMode    = !!sdnfExpInfo.specMode
  !!sdnfExpdata.markMode    = !!sdnfExpInfo.markMode
  !!sdnfExpdata.hdrSource   = !!sdnfExpInfo.hdrSource
  !!sdnfExpdata.fileVersion = !!sdnfExpInfo.fileVersion
  !!sdnfExpdata.modelType   = !!sdnfExpInfo.modelType

  -- output warning if we are not exporting anything
  if( not !!sdnfExpInfo.linMem and not !!sdnfExpInfo.arcMem and not !!sdnfExpInfo.plate )then
    -- Nothing to export
    !error          = object SDNFERROROBJ( )
    !error.severity = !!sdnfSevWarn
    !error.status   = !!sdnfErrNoExpItem
    !error.query    = !!sdnfQueNone
    !unusedReply = !!sdnfError( !error )
  endif

endfunction

------------------------------------------------------------------------
