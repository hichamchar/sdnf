--
--
-- Description:
--   Updates the transfer revision numbers.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Item refno
--
-- Return:
--   [Data Type]  [Description]
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfupdaterevnos( )

   if( not !!sdnfTestRun )then
      !thisTraNo = ( :SDNFTRANO )
      if( !thisTraNo eq 1 )then
         -- Has not yet been exported
         !siteTraNo = ( :SDNFTRANO of $!!sdnfConfigObj )
         -- Build text version
         !trrvNo = !!sdnfVersionList.substring( !siteTraNo, 1 ) + |.0|
         :SDNFTRANO $!siteTraNo
         handle ANY
            -- DB is read only
            !ref = ( ref )
            !!sdnfVerFile.writeRecord( !ref.string( ) )
            !!sdnfVerFile.writeRecord( |:SDNFTRANO $!siteTraNo| )
            !!sdnfVerFile.writeRecord( |:SDNFTRRVNO  '$!trrvNo'| )
            return
         endhandle
         :SDNFTRRVNO  |$!trrvNo|
      endif
   endif

endfunction
