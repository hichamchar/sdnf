--
--
-- Description:
--   Increments export HWM.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      REAL        Transfer number
--    2   R      REAL        Revision number
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ  Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfIncExportHWM( !transferNo is REAL, !revNo is REAL ) is SDNFERROROBJ

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Save start pos
  !start = ( ref )

  -- Go to session specific Config Site
  $!!sdnfConfigObj
  !transferNo = ( !transferNo + 1 )
  if( !transferNo gt $!!sdnfVerListLen )then
    -- Reset traNo
    !unusedTraNo = 2
  endif
  :SDNFTRANO $!transferNo

  !revNo = ( 0 )
  :SDNFREVNO $!revNo

  !trrvNo = !!sdnfVersionList.substring( !transferNo, 1 ) + |.$!revNo|
  :SDNFTRRVNO  |$!trrvNo|

  -- Update session added object name
  !!sdnfSessAddedObj = !!sdnfAddedObjArea + |/| + !trrvNo.trim( )
--  !!sdnfSessAddedObj = !!sdnfAddedObjArea + |/| + !!sdnfUnique
  !!sdnfSessAddedObj = !!sdnfValidateName( !!sdnfSessAddedObj )

  -- Return to base
  $!start

  -- Finished
  return !error

endfunction

------------------------------------------------------------------------
