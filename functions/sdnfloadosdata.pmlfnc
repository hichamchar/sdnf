--
-- Description:
--   Loads operating system specific data.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      This operating system
--    2   R      STRING      The other operating system
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfLoadOSData( ) is SDNFERROROBJ

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- WINDOWS
  !!sdnfOSRemove    = |del /f|
  !!sdnfExeSfx    = |.exe|
  !!sdnfPathSeparatr = |\|
  !!sdnfCopy = |copy|

  -- Determine file converters
  !!sdnfImpConv = ||
  !!sdnfExpConv = ||

  -- Finished
  return !error

endfunction

