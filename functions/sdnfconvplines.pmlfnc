--
--
-- Description:
--   Tries to convert incoming Plines to non Cardinal Point equivalents
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      DBREF       Refno of element (Linear Member)
--
-- Return:
--   [Data Type] [Description]
--    None
------------------------------------------------------------------------

-- Define function
define function !!sdnfConvPlines( !ref is STRING )

  -- Save start position
  !start = ( ref )

  -- Go to element
  $!ref

  -- Get list of Plines available
  !list = ( plna )
  !jusl = ( jusl )
  !strPlines = |LBOT.CBOT.RBOT.LMID.CMID.RMID.LTOP.CTOP.RTOP.NA.BNA.LNA.RNA.TNA|

   -- Look for match by position
   !juslStart = PLSTCU $!jusl
   handle any
      -- Unset SPRE probably
      return
   endhandle

   -- Is it already one of the proper Plines
   if( !jusl.match( |SNF| ).eq( 0 ) and $
      !strPlines.match( !jusl ).eq( 0 ) )then

      -- Try to map it to one of the proper Plines
      do !val values !list

         if( !val.match( |SNF| ).neq( 0 ) or $
            !strPlines.match( !val ).neq( 0 ) )then

            -- Test for closest end position of NON interface Plines
            !testStart = PLSTCU $!val
            if( !juslStart.wrt( WORL ).distance(!testStart.wrt( WORL ) ).lt( 1.0 ) )then
               -- Found match set it to the new one
               jusl $!val
               if( !!sdnfDebug )then
                     !spre = (flnm of spre)
                     write( |$!spre - Pline $!jusl is positionally equivalent to $!val| )
               endif
               break
            endif
         endif
      enddo
   endif

  -- Return to base
  $!start

endfunction

------------------------------------------------------------------------
