-- Description:
--   PML object to store SDNF file header information.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Object
-- Member data:
--   [#]     [R/RW] [Data Type] [Description]
--    .firm       R  STRING
--    .client     R  STRING
--    .structure  R  STRING
--    .project    R  STRING
--    .date       R  STRING
--    .time       R  STRING
--    .revision   R  STRING
--    .issue      R  STRING      Used to store name of source package
--    .designcode R  STRING
--
------------------------------------------------------------------------

-- Define object
define object SDNFHEADEROBJ

  -- Member Data
  member .fileVersion is STRING
  member .sDNFVersion is STRING
  member .firm        is STRING
  member .client      is STRING
  member .structure   is STRING
  member .project     is STRING
  member .date        is STRING
  member .time        is STRING
  member .revision    is STRING
  member .issue       is STRING
  member .designcode  is STRING
  member .packets     is ARRAY
  member .modelNr     is REAL
  member .error       is STRING

endobject
