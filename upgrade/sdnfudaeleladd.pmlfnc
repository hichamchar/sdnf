--
-- Description:
--   Adds the elements to the ELELIST attribute.
--   Handles attempts to add element type already in list.
--
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type] [Description]
--    None
------------------------------------------------------------------------

-- Define function
define function !!sdnfudaeleladd( !listName is STRING, !list is STRING )

   !eleTypes = !list.split( )

   if( !eleTypes.size( ).gt( 0 ) )then
      do !eleType values !eleTypes
         $!listName ADD $!eleType
         handle any
            -- write( |$!eleType already in ELELIST| )
         endhandle
      enddo
   endif

endfunction
