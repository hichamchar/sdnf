--
-- Description:
--   Lists the UDAs for the SDNF system.

-- Define function
define function !!sdnfshowuda( )

   -- set up synonym
   $S ssu=!!sdnfshowuda( )

   -- list :SDNF UDAs
   !type = type
   !elementType = object ELEMENTTYPE(!type)
   !udas = !elementType.udas()
   do !uda values !udas
      !name = !uda.name()
      if( !name.upcase( ).match( |:SDNF| ).gt( 0 ) )then
         QUERY $!name
      endif
   enddo

endfunction
