-- Author:          D.Wilson
-- Created:         Mon Apr 28 14:07:39 1998
--
-- Description:
--   Sets Export Information form file name and details.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      File to be produced
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ  Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetExpFile( !file is STRING ) is SDNFERROROBJ

  -- Save start position
  !start = ( ref )

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- If user has cancelled without selecting a file
  if( !file.upcase().eq(|NULL|) )then
    return !error
  endif

  -- See if we have entered a filename
  if( !file.unset( ) or $
      !file.length( ) eq 0 ) then
    !error.severity = !!sdnfSevError
    !error.status   = !!sdnfErrNoOutFile
    !error.query    = !!sdnfQueNone
    !reply = !!sdnfError( !error )
  else
    !tempFile = !!sdnfExpandEnv( !file )

    -- Get file names entered
    !mode = |WRITE|

    -- Test to see if file exists
    !testFile = object FILE( !tempFile )
    if( !testFile.exists( ) )then
      -- This should not exist - overwrite?
      !error.severity = !!sdnfSevConfirm
      !error.status   = !!sdnfErrIsExpFile
      !error.query    = !!sdnfQueOverwrite
      !error.default  = |NO|
      !reply = !!sdnfError( !error )
      -- Manage reply
      if( !reply eq |YES| )then
        -- Overwrite mode
        !mode = |OVERWRITE|
      elseif( !reply eq |NO| )then
        -- Unset file
        !tempFile = ||
      endif
    endif

    -- Set Form fields
    !!sdnfExpInfo.expFile.val     = !tempFile
    !!sdnfExpInfo.expFileMode.val = !mode
    !!sdnfExpInfo.file            = !tempFile
    !!sdnfExpInfo.fileMode        = !mode

    -- Update Search Start
    if( !tempFile.upcase( ).neq( |NULL| ) )then
       !pathName = !testFile.pathName()
       if( !pathName.length( ).gt( 0 ) )then
         !!sdnfSearchStart = !pathName
       endif
    endif

  endif

  -- Return to start
  $!start
  return !error

endfunction

------------------------------------------------------------------------
