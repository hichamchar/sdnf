-- Define function
define function !!sdnfExpRunInfIni( )

  -- Initialise choices
  !!sdnfExpRunInf.expViewLog.val  = !!sdnfExpdata.viewLog
  !!sdnfExpRunInf.expMode.val     = !!sdnfExpdata.viewMode
  !!sdnfExpRunInf.testRun         = false

  -- Set Member Data
  !!sdnfExpRunInf.viewMode        = !!sdnfExpdata.viewMode
  !!sdnfExpRunInf.viewLog         = !!sdnfExpdata.viewLog
  !!sdnfExpdata.testRun           = !!sdnfExpRunInf.testRun

endfunction

