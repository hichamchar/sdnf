--
-- Description:
--   Does nothing except output a message that we cannot change
--   this operating system.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]   [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetThisOpSys( )


  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevWarn
  !error.status   = !!sdnfErrNoAltSys
  !error.query    = !!sdnfQueNone
  !unusedReply = !!sdnfError( !error )

  -- Reset option
  !!sdnfImpRunInf.thisOpSystem.select( |DTEXT|, !!sdnfThisOpSys )
  handle any
    -- Probably form does not exist
  endhandle
  !!sdnfExpRunInf.thisOpSystem.select( |DTEXT|, !!sdnfThisOpSys )
  handle any
    -- Probably form does not exist
  endhandle

endfunction

------------------------------------------------------------------------
