--
-- Description:
--   Initialises the !!sdnfSourInfo form.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]  [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSourInfoInit( )

  -- Initialise choices
  !source        = !!sdnfImpdata.source
  !sourceMapMode = !!sdnfImpdata.mapMode
  !sourceMatMode = !!sdnfImpdata.matMode
  !!sdnfSourInfo.sourceMapMode.select( !sourceMapMode )
  !!sdnfSourInfo.sourceMatMode.select( !sourceMatMode )

  -- make RTEXT upper case
  !!sdnfSourInfo.autoSourceMap.dText = !!sdnfExtProgList
  !rText = !!sdnfSourInfo.autoSourceMap.dText
  do !prog values !rText
   !prog = !prog.upcase( )
  enddo
  !!sdnfSourInfo.autoSourceMap.rText = !rText

  do !val values !!sdnfSourInfo.autoSourceMap.dText
    if( !val.upcase( ) eq !source.upcase( ) ) then
      !!sdnfSourInfo.autoSourceMap.select( |DTEXT|, !val )
    endif
  enddo
  -- Set Member Data
  !!sdnfSourInfo.source   = !!sdnfThisProg
  !!sdnfSourInfo.source   = !source
  !!sdnfSourInfo.mapMode  = !sourceMapMode
  !!sdnfSourInfo.matMode  = !sourceMatMode

  call !!sdnfSetSMapMode( )

endfunction

------------------------------------------------------------------------
