--
--
-- Description:
--   Sets the Highlight Form Version details.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      START or END
--
-- Return:
--   [Data Type]   [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfHighSelVers( !startEndFlag is STRING )

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Set form variable

  -- Activate/deactivate form gadgets
  if( !startEndFlag eq |START| )then
    !transfer = !!sdnfHighlighter.vSTransfer.selection( )
    !revision = !!sdnfHighlighter.vSRevision.val
  elseif( !startEndFlag eq |END| )then
    !transfer = !!sdnfHighlighter.vETransfer.selection( )
    !revision = !!sdnfHighlighter.vERevision.val
  endif

  -- Are these valid choices
  !transfer = !transfer.upcase( )
  if( !revision lt 0 or $
      !!sdnfVersionList.match( !transfer ) eq 0 )then
    -- Bad version
    !error.severity = !!sdnfSevWarn
    !error.status   = !!sdnfErrBadVers
    !error.query    = !!sdnfQueNone
    !unusedReply = !!sdnfError( !error )
    call !!sdnfHighLighInit( )
  else
    -- Set form variables
    if( !startEndFlag eq |START| )then
      !!sdnfHighlighter.startTransfer = !!sdnfVersionList.match( !transfer )
      !!sdnfHighlighter.startRevision = !revision
    elseif( !startEndFlag eq |END| )then
      !!sdnfHighlighter.endTransfer = !!sdnfVersionList.match( !transfer )
      !!sdnfHighlighter.endRevision = !revision
    endif
  endif

  -- Finished

endfunction

------------------------------------------------------------------------
