--
-- Description:
--   Converts file name according to operating system requirements.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Input string
--
-- Return:
--   [Data Type]   [Description]
--    STRING        Output string
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfConvFileName( !iString is STRING ) is STRING

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Initialise
  !oString = !iString

  -- Convert tree name to WINDOWS form
  !oString = !iString.replace( '/', '\' )

  -- Finished
  return !oString

endfunction

------------------------------------------------------------------------
