-- Author:          D.Wilson
-- Created:         Mon Apr 28 14:07:39 1998
--
-- Description:
--   Extracts system configuration details.
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type]  [Description]
--    SDNFERROROBJ Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfGetConfig( ) is SDNFERROROBJ

   -- Save start position
   !start = ( ref )

   -- Initialise Error object
   !error          = object SDNFERROROBJ( )
   !error.severity = !!sdnfSevOK
   !error.status   = !!sdnfErrOK
   !error.query    = !!sdnfQueNone

   -- Test for updated Catalogue (old = 1; new = 2)
   WORL
   !pkey = !!sdnfTestPlines[ 1 ]
   var !coll collect all PLIN with ( PKEY eq |$!pkey| )
   handle any
      -- Probably uninitialised system - was it installed?
      !!alert.error( |Interface not initialised.| )
   endhandle

   !pkey = !!sdnfTestPlines[ 2 ]
   var !coll append collect all PLIN with ( PKEY eq |$!pkey| )
   if( !coll.empty( ) )then
      -- SDNF Plines not present
      -- List upgrade instructions if possible
      !fileName = !!pml.getpathname( |sdnfcataupgrade.pmldat| )
      handle any
         -- File does not exist - was it installed?
         !error.severity = !!sdnfSevFatal
         !error.status   = !!sdnfErrNoPlines
      endhandle
      !file = object FILE( !fileName )
      !lines = !file.readFile( )
      do !line values !lines
         write( !line )
      enddo
      -- Fatal error
      !error.severity = !!sdnfSevFatal
      !error.status   = !!sdnfErrNoPlines
   endif

   if( !error.severity.eq( !!sdnfSevOK ) )then
      -- go to Config Site
      $!!sdnfConfigObj
      handle( 2,109 )
         -- Configuration object does not exist
         !error.severity = !!sdnfSevConfirm
         !error.status   = !!sdnfErrNoConfig
         !error.query    = !!sdnfQueInstall
         !error.default  = |NO|
         !reply = !!sdnfError( !error )
         if( !reply eq |YES| )then
            -- Load up the data
            !error = !!sdnfLoadConfig( )
            $!!sdnfConfigObj
         else
            -- Fatal Error - Give up
            !error.severity = !!sdnfSevFatal
            !error.query    = !!sdnfQueNone
            !reply = !!sdnfError( !error )
            golabel /Finished
         endif
      endhandle

      -- Try editing it to see if we have R/W access to it
      -- But... this may be in a different database from the main model.
      !area = ( AREA )
      AREA 1
      handle any
         -- Fatal Error - Give up
         !error.severity = !!sdnfSevFatal
         !error.status   = !!sdnfErrNoRWAcces
         !error.query    = !!sdnfQueNone
      elsehandle NONE
         -- Reset it
         AREA $!area
      endhandle
   endif

   -- Finished
   label /Finished
   if( !error.severity.neq( !!sdnfSevOK ) )then
      !reply = !!sdnfError( !error )
   endif
   -- Return to start
   $!start
   return !error

endfunction

------------------------------------------------------------------------
