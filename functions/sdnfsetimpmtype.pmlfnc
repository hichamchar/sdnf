-- Define function
define function !!sdnfSetImpMType( )

  -- Set Form member data
--  !!sdnfImpInfo.modelType = !!sdnfImpInfo.impModelType.selection( )

  -- Set Form member data
  if( !!sdnfImpInfo.impModelType.val ) then
    !!sdnfImpInfo.modelType = |WP|
  else
    !!sdnfImpInfo.modelType = |CP|
  endif

endfunction

