--
--
-- Description:
--   Sets Mapping File according to arguments.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Direction [EXPORT|IMPORT]
--    2   R      STRING      Mode [MANUAL|AUTO]
--    3   R      STRING      Map Type [PROFILE|MATERIAL]
--    4   R      STRING      Mapping file name
--    5   R      STRING      Source
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ  Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetMainMap( !direction is STRING, !mode is STRING, $
  !unusedMapType is STRING, !inFile is STRING, !source is STRING ) is SDNFERROROBJ

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Strip out environment variables
  if( !inFile.unset( ) or !inFile.length( ) eq 0 )then
    !file = | |
  endif
  !file = !!sdnfExpandEnv( !inFile )

  -- Go and do the right thing
  if( !direction eq |EXPORT| )then
    -- Not for Export
  elseif( !direction eq |IMPORT| )then
    if( !mode eq |AUTO| )then
      !error = !!sdnfSetMainSMap( !source )
      !error = !!sdnfSetMainSMat( !source )
      !error = !!sdnfSetMainSOri( !source )
    elseif( !mode eq |MANUAL| )then
      -- Not for Manual
    else
      -- Unknown mode
    endif
  else
    -- Unknown direction
  endif

  -- Finished
  label /Finished
  return !error

endfunction

------------------------------------------------------------------------
