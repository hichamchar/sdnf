-- File:          sdnfsetusersuni.pmlfnc
-- Type:          Function Definition
--
-- Author:          D.Wilson
-- Created:         12/11/2010 10:36:43
--
-- Description:
--   Sets the User Source Unicode mapping table file details,
--   checking that one exists and it is valid.
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ  Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfsetusersuni( !file is STRING ) is SDNFERROROBJ

  -- Save start position
  !start = ( ref )
  !tempFile = !file
  !prefix = |Unicode:   |

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Test to see if file exists
  !tempFile = !file
  !error = !!sdnfTestMapFile( !file, !!sdnfSourInfo.autoSourceMap.selection( ), !!sdnfUniSep )
  if( !error.status neq !!sdnfErrOK )then
    -- Handle error
    !unusedReply = !!sdnfError( !error )
    !tempFile = ||
  endif

  -- Finished

  -- Set Form fields
  !!sdnfSourInfo.userSourceFile.val = !tempFile
  !!sdnfSourInfo.uniFile            = !tempFile
  !!sdnfSourInfo.sourceUniFile.val  = !prefix + !!sdnfContractString( !tempFile, !!sdnfMaxNameLen, |...| )

  -- Return to start
  $!start
  return !error

endfunction

------------------------------------------------------------------------
