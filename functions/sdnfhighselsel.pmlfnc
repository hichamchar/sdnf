--
-- Description:
--   Sets the Highlight Selection details.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      START or END
--
-- Return:
--   [Data Type]   [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfHighSelSel( !selectionFlag is STRING )

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Set form variable

  -- Activate/deactivate form gadgets
  if( !selectionFlag eq |ADDED| )then
    !!sdnfHighlighter.added = !!sdnfHighlighter.highAdded.val
  elseif( !selectionFlag eq |CHANGED| )then
    !!sdnfHighlighter.changed = !!sdnfHighlighter.highChanged.val
  elseif( !selectionFlag eq |DELETED| )then
    !!sdnfHighlighter.deleted = !!sdnfHighlighter.highDeleted.val
  endif

  -- Finished

endfunction

------------------------------------------------------------------------
