-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      BOOLEAN     Flag to describe super-user status
--    None
--
-- Return:
--   [Data Type]  [Description]
--    None
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfsufunction( !status is BOOLEAN )

   !!sdnfSUStatus       = !status
   if( !status )then
      -- turn on super user flags
      if( !!sdnfDebug )then
         write( |Super user status ON| )
      endif
      !!sdnfRebuildGensec = false
   else
      -- turn off super user flags
      if( !!sdnfDebug )then
         write( |Super user status OFF| )
      endif
      !!sdnfRebuildGensec = true
   endif

endfunction

------------------------------------------------------------------------
