--
--
-- Description:
--   Sets user defined Mapping File mode for Source Map in SDNF Export form.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    1   R      STRING      Mapping file name
--
-- Return:
--   [Data Type]   [Description]
--    SDNFERROROBJ  Error object
--
------------------------------------------------------------------------

-- Define function
define function !!sdnfSetUserSMap( !file is STRING ) is SDNFERROROBJ

  -- Save start position
  !start = ( ref )
  !tempFile = !file
  !prefix = |Profiles:  |

  -- Initialise Error object
  !error          = object SDNFERROROBJ( )
  !error.severity = !!sdnfSevOK
  !error.status   = !!sdnfErrOK
  !error.query    = !!sdnfQueNone

  -- Test to see if file exists
  !tempFile = !file
  !error = !!sdnfTestMapFile( !file, !!sdnfSourInfo.autoSourceMap.selection( ), !!sdnfProfSep )
  if( !error.status neq !!sdnfErrOK )then
    -- Handle error
    !unusedReply = !!sdnfError( !error )
    !tempFile = ||
  endif

  -- Finished

  -- Set Form fields
  !!sdnfSourInfo.userSourceFile.val = !tempFile
  !!sdnfSourInfo.mapFile            = !tempFile
  !!sdnfSourInfo.sourceMapFile.val  = !prefix + !!sdnfContractString( !tempFile, !!sdnfMaxNameLen, |...| )

  -- Return to start
  $!start
  return !error

endfunction

------------------------------------------------------------------------
