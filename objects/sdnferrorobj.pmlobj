-- Define object
define object SDNFERROROBJ

  -- Member Data
  member .severity is REAL
  member .status   is REAL
  member .query    is REAL
  member .message  is STRING
--    message to use if .status is !!sdnfErrUserMessage
  member .default  is STRING
--    default query result to use when in tty or non-interactive mode

endobject
