-- Kill existing Form definition
kill !!sdnfViewImpFile
handle( 61,125 )
   -- Form not found
endhandle

------------------------------------------------------------------------

-- Export form
setup form !!sdnfViewImpFile
  title      |$!!sdnfProduct - Import File Header|
  icontitle  |OSDE|
  initialise |!!sdnfVwImpFilInit( !!sdnfImpdata.file )|

  path right
  para .pSDNFVersion at X0 YMAX text |SDNF Version    |
  para .vSDNFVersion  width 60 lines 1
  para .pFirm        at X0 YMAX text |Engineering Firm|
  para .vFirm         width 60 lines 1
  para .pClient      at X0 YMAX text |Client          |
  para .vClient       width 60 lines 1
  para .pStructure   at X0 YMAX text |Structure ID    |
  para .vStructure    width 60 lines 1
  para .pProject     at X0 YMAX text |Project ID      |
  para .vProject      width 60 lines 1
  para .pDate        at X0 YMAX text |Date of Export  |
  para .vDate         width 60 lines 1
  para .pTime        at X0 YMAX text |Time of Export  |
  para .vTime         width 60 lines 1
  para .pRevision    at X0 YMAX text |Revision        |
  para .vRevision     width 60 lines 1
  para .pIssue       at X0 YMAX text |Issue           |
  para .vIssue        width 10 lines 1
  para .pDesigncode  at X0 YMAX text |Design Code     |
  para .vDesigncode   width 60 lines 1

  -- Button
  button .cancel  at X0 YMAX+1 | Cancel | callback |kill !!sdnfViewImpFile| cancel

  -- Member data
  member .file         is STRING
  member .sdnfVersion  is STRING
  member .firm         is STRING
  member .client       is STRING
  member .structure    is STRING
  member .project      is STRING
  member .date         is STRING
  member .time         is STRING
  member .revision     is STRING
  member .issue        is STRING
  member .designcode   is STRING

exit

------------------------------------------------------------------------
