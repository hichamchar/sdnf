-- Define function
define function !!sdnfSetImpRunInf( )

  -- Set Form Member Data
  !!sdnfImpRunInf.viewMode  = !!sdnfImpRunInf.impMode.selection( )
  !!sdnfImpRunInf.viewLog   = !!sdnfImpRunInf.impViewLog.val
  !!sdnfImpRunInf.saveModel = !!sdnfImpRunInf.impSaveModel.val

  -- Set Export Form member data
  !!sdnfImpdata.viewMode     = !!sdnfImpRunInf.viewMode
  !!sdnfImpdata.viewLog      = !!sdnfImpRunInf.viewLog
  !!sdnfImpdata.saveModel    = !!sdnfImpRunInf.saveModel
  !!sdnfImpdata.mapVerify    = !!sdnfImpRunInf.mapVerify
  !!sdnfImpdata.markVerify   = !!sdnfImpRunInf.markVerify
  !!sdnfImpdata.sortMode     = !!sdnfImpRunInf.sortMode

  -- Attribute modification lists from child form
  !!sdnfImpdata.linMemAttr   = !!sdnfImpRunInf.linMemAttr
  !!sdnfImpdata.plateAttr    = !!sdnfImpRunInf.plateAttr

endfunction

