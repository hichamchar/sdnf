--
-- Description:
--   Removes SDNF Plines from the Catalogue.
--   Macro to be called from Paragon.
-- Autoname
-- Storage Area
-- Specification
-- Material
--
------------------------------------------------------------------------
--
-- Function Type:   Function/Procedure
-- Arguments:
--   [#] [R/RW] [Data Type] [Description]
--    None
--
-- Return:
--   [Data Type] [Description]
--    None
------------------------------------------------------------------------

-- Define function
define function !!sdnfRemPlines( )

  -- Removes all SDNF related Plines in the Catalogue DB
  WORL

  -- Collect all Plines with SNF in their PKEY
  var !list coll all PLIN where ( matchwild( PKEY, |SNF*| ) ) for CE
  !length = !list.size( )
  write( |$!length $!!sdnfShortProduct Plines to delete| )

  -- Go and delete them
  do !val values !list
    $!val
    write( |Deleting PLIN $!val| )
    DELETE PLIN
    handle any
       write( |Error in deleting PLIN $!val| )
    endhandle
  enddo

endfunction

------------------------------------------------------------------------
